  "verdicts": [
    {
      "action": "Lower model.score_head_kernel (try 3) or lower frame_stride so median T >> 9. Both fire lesson C2 on existing caches.",
      "detail": "55.4% of test clips are <= kernel_size 9 (median T = 9); 24.3% of frames live in them. Every output timestep there sees the whole clip.",
      "level": "CRITICAL",
      "title": "Score head spans the clip (lesson C27)"
    },
    {
      "action": "Lower loss.mil_topk_pct, or accept that supervision is clip-level here and stop reading frame-level claims into it.",
      "detail": "90.3% of clips get k = 1 at mil_topk_pct = 16: one supervised frame per clip per step.",
      "level": "HIGH",
      "title": "MIL top-k degenerates to a plain max"
    },
    {
      "action": "Exclude them at scoring time (core/docs/DADA_SETUP.md \u00a75.1). Do NOT 'fix' this with --strict: that flag raises, it does not repair.",
      "detail": "4 clips declared abnormal in meta.json have no positive sampled frame; every metric counts them as normal.",
      "level": "HIGH",
      "title": "Abnormal clips with an all-zero label vector"
    },
    {
      "action": "Report auc_macro as the headline and print this oracle beside any micro number. Never place a micro number from this corpus next to a published frame-level AUC.",
      "detail": "A constant-score-per-clip oracle scores micro AUC 0.9086 with zero localization; 99.9% of the positive/negative pairs span two clips.",
      "level": "CRITICAL",
      "title": "Micro AUC here is mostly clip classification (lesson C12)"
    },
    {
      "action": "Rebuild the corpus into fixed-length windows with the anomaly at a random offset. Until then, print this baseline beside every micro AUC and treat any arm that fails to beat it as unmeasured.",
      "detail": "A constant-score-per-clip detector reading only the clip's frame count scores clip-level AUC 0.8105 and micro AUC 0.8654 \u2014 shorter clips are the abnormal ones. 107 normal clips (3,157 frames) fall outside the abnormal length range entirely.",
      "level": "CRITICAL",
      "title": "Clip length alone predicts the label (lesson C28)"
    },
    {
      "action": "No head on these features can localize. Frame-level work on this corpus needs a different backbone or a finer stride -- not another KIP variant (RESULTS_DADA.md \u00a76, \u00a710-C).",
      "detail": "Even a supervised linear probe reaches only auc_macro 0.5228, while the clip-level probe reaches 0.6799.",
      "level": "CRITICAL",
      "title": "The features carry no frame-level signal"
    }
  ]
